# Database
DATABASE_URL=postgresql://leadgen_user:leadgen_pass@db:5432/leadgen_db

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Internal API key for bots (Google Maps bot, Website scraper, Social scraper, AI service)
INTERNAL_API_KEY=change-this-to-a-long-random-key

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Exports (Database & Sheets module).
# Folder the weekly CSV files are written to. Open them in Excel, or upload
# them to Google Sheets by hand. Relative paths resolve from backend/.
EXPORT_DIR=exports
